# Copy to .env and fill in.

# Base URL of the Rakshak backend API (no trailing slash). The WebSocket URL
# is derived from this by swapping http(s) for ws(s).
VITE_API_BASE=http://127.0.0.1:8000

# OpenRouteService API key for route directions — get a free one at
# https://openrouteservice.org/dev/#/signup
VITE_ORS_KEY=your_key_here
