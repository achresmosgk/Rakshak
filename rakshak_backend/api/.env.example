# Copy to .env and fill in for your deployment. All values here have safe
# local-dev defaults (see settings.py), so nothing below is required to run
# locally — only for a real deployment.

# Long random string used to sign JWTs — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# redis://<host>:<port> or rediss://... for TLS. Used for token revocation.
REDIS_URL=redis://localhost:6379

# Path to the sqlite database file. Point this at a persistent volume in
# production so data survives container restarts.
DATABASE_PATH=nilgai.db

# Comma-separated list of frontend origins allowed to call this API, e.g.
#   CORS_ORIGINS=https://rakshak.app,https://www.rakshak.app
# Leave as * only for local development.
CORS_ORIGINS=*

# The single admin identity — not a signed-up user, just a fixed credential
# pair checked directly against these values. Change both before deploying.
ADMIN_EMAIL=admin@rakshak.app
ADMIN_PASSWORD=changeme-admin-pass
